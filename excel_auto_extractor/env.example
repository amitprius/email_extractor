# Copy this file to ".env" (same folder as app.py) and fill it in. Never share it.
GEMINI_API_KEY=your-gemini-api-key

# Optional. Models are tried in this order; if one is unavailable or out of free quota the next is used.
# Check which models your free tier allows in Google AI Studio.
GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash

# Optional. Where downloads, JSON files, logs and output Excel files are stored (default: "workspace" next to app.py)
# WORKSPACE_DIR=D:\excel_workspace
